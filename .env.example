# ---------------------------------------------------------------------------
# Take Me Home — environment contract
#
# Copy to .env.local for development. .env* files are gitignored; never commit
# real values.
#
# Phase 0 (the marketing route) needs none of these. They are required from
# Iteration 2 onward, when authentication goes in.
# ---------------------------------------------------------------------------

# Public — inlined into the client bundle. Safe to expose; the anon key is
# protected by row-level security, not by secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses row-level security. Must never reach the browser and
# must never be prefixed NEXT_PUBLIC_. Only lib/supabase/admin.ts may read it.
SUPABASE_SERVICE_ROLE_KEY=

# Local Postgres used by the database test suite (npm run test:db).
# Not a Supabase connection — a throwaway cluster the harness manages.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:55432/postgres
